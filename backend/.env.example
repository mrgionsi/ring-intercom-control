NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Number of trusted proxy hops for req.ip, rate limiting, and secure-cookie handling.
TRUST_PROXY=0

# Admin credentials
# Generate ADMIN_PASSWORD_HASH with one of:
# npm run hash-password -- yourPassword
# node -e "const bcrypt=require('./node_modules/bcryptjs'); console.log(bcrypt.hashSync('yourPassword', 12));"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Required secrets
# Generate SESSION_SECRET with: openssl rand -hex 32
# Generate MASTER_KEY with: openssl rand -base64 32
# MASTER_KEY must decode to exactly 32 bytes.
SESSION_SECRET=
MASTER_KEY=

# Optional database path (defaults to ./data.db)
DB_PATH=./data.db
SESSION_DB_FILE=session.db
UNLOCK_EVENTS_MAX=10000
