NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Admin credentials (hash with: npm run hash-password -- yourPassword)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Required secrets
SESSION_SECRET=
MASTER_KEY=

# Optional database path (defaults to ./data.db)
DB_PATH=./data.db
UNLOCK_EVENTS_MAX=10000
