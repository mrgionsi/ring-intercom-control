{
  "name": "ring-intercom-backend",
  "private": true,
  "version": "0.1.2-beta",
  "type": "module",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "hash-password": "node -e \"const bcrypt=require('bcryptjs'); const pw=process.argv[1]; if(!pw){console.error('Usage: npm run hash-password -- yourPassword'); process.exit(1);} console.log(bcrypt.hashSync(pw, 12));\"",
    "security:check": "npm audit --production"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-sqlite3": "^0.9.16",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.1",
    "ring-client-api": "^14.3.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.39",
    "tsx": "^4.10.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "sqlite3": "$sqlite3",
    "uuid": "^14.0.0"
  }
}
