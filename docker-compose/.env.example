# Container images
# Use versioned tags published to GHCR, for example:
# BACKEND_IMAGE=ghcr.io/mrgionsi/ring-intercom-control-backend:0.1.0
# FRONTEND_IMAGE=ghcr.io/mrgionsi/ring-intercom-control-frontend:0.1.0
BACKEND_IMAGE=ghcr.io/mrgionsi/ring-intercom-control-backend:latest
FRONTEND_IMAGE=ghcr.io/mrgionsi/ring-intercom-control-frontend:latest

# Host ports
BACKEND_PORT=3001
FRONTEND_PORT=5173

# Backend configuration
# Use NODE_ENV=production for HTTPS deployments.
# Use NODE_ENV=development for plain HTTP testing on a local/private network.
NODE_ENV=production
DB_PATH=/data/data.db
SESSION_DB_FILE=session.db
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-random-hex-session-secret
# Generate with: openssl rand -base64 32
# MASTER_KEY must decode to exactly 32 bytes.
MASTER_KEY=replace-with-base64-32-byte-key
ADMIN_USERNAME=admin
# Generate with one of:
# npm run hash-password -- yourPassword
# node -e "const bcrypt=require('./backend/node_modules/bcryptjs'); console.log(bcrypt.hashSync('yourPassword', 12));"
# In Docker Compose and Portainer stack deployments, escape each $ as $$ when
# the bcrypt hash is consumed by the stack configuration.
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
CLIENT_ORIGIN=http://localhost:5173

# Frontend proxy settings
MAX_BODY_BYTES=1048576
PROXY_TIMEOUT_MS=15000
