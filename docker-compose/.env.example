# Container images
# Use versioned tags published to GHCR, for example:
# BACKEND_IMAGE=ghcr.io/mrgionsi/ring-intercom-control-backend:0.1.0
# FRONTEND_IMAGE=ghcr.io/mrgionsi/ring-intercom-control-frontend:0.1.0
BACKEND_IMAGE=ghcr.io/mrgionsi/ring-intercom-control-backend:latest
FRONTEND_IMAGE=ghcr.io/mrgionsi/ring-intercom-control-frontend:latest

# Host ports
BACKEND_PORT=3001
FRONTEND_PORT=5173

# Backend configuration
NODE_ENV=production
DB_PATH=/data/data.db
SESSION_DB_FILE=session.db
SESSION_SECRET=replace-with-random-hex-session-secret
MASTER_KEY=replace-with-base64-32-byte-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
CLIENT_ORIGIN=http://localhost:5173

# Frontend proxy settings
MAX_BODY_BYTES=1048576
PROXY_TIMEOUT_MS=15000
